# Environment Variables for TireTrack
# Copy this file to .env and update the values

# Server
PORT=3001
NODE_ENV=development

# PIN Authentication
ADMIN_PIN=9999
TECH_PIN=1234

# Session
SESSION_SECRET=tiretrack-secret-change-me
SESSION_EXPIRY_HOURS=24

# MongoDB
# MONGO_ROOT_USERNAME / MONGO_ROOT_PASSWORD are consumed by docker-compose
# to provision the root user. MONGODB_URI is what the Node app uses to
# connect; the credentials in the URI must match the two above.
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=change-me
# Host options (pick one):
#   • OrbStack on macOS: use container DNS `tiretrack-mongo.orb.local` (the
#     `127.0.0.1:27017` port forwarder breaks the Mongo wire handshake).
#   • Docker Desktop / Linux: use `127.0.0.1:27017` (not `localhost` — Node's
#     IPv6-first DNS resolution otherwise hits ECONNRESET on macOS).
MONGODB_URI=mongodb://root:change-me@tiretrack-mongo.orb.local:27017/?authSource=admin
MONGODB_DB=tiretrack

# MongoDB
# Local:  mongodb://localhost:27017/tiretrack
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/tiretrack
MONGODB_URI=mongodb://localhost:27017/tiretrack

# Backup S3 Config (MinIO or AWS S3)
S3_ENDPOINT=https://s3.example.com
S3_BUCKET=tiretrack-app
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key
S3_REGION=us-east-1
